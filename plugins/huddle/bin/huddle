#!/usr/bin/env python3
"""huddle — ask the user a rich question in an agterm HTML overlay and print the answer as JSON.

  huddle SPEC.json | huddle - < spec.json      ask from a JSON spec (see SKILL.md for the schema)
  huddle q "Prompt" "Label|subtitle" "*Recommended|subtitle|why" ... [--multi] [--context MD]
  huddle wait PAGE_ID                          resume waiting after a timeout (exit 4)
  huddle demo [NAME ...]                       open bundled demos (no name: list them)
  huddle templates                             list templates with their one-line purpose
  huddle render SPEC -o FILE                   build the page only, open nothing
  huddle hook-stop                             the plugin's Stop hook (not for agents to run)

Common flags: --follow (pull the user to this session), --size N (floating panel, % of the
session), --timeout SEC (default 570, under the Bash tool's 600 s cap), --browser (force the
local-browser fallback), --no-status (leave the sidebar glyph alone).

Exit codes: 0 answered or "chat" (user wants to discuss in the terminal), 2 dismissed (closed
unanswered), 3 no way to show it (outside agterm without --browser, or an unattended run),
4 still pending after --timeout (run `huddle wait ID`), 5 the session already shows an overlay,
1 error.

Environment: AGTERMCTL (path to agtermctl), HUDDLE_CONFIG (personal defaults, default
~/.config/huddle/defaults.json; "browser": true there opens the page in the browser outside agterm).
"""
import argparse
import base64
import glob
import hashlib
import http.client
import http.server
import json
import mimetypes
import os
import secrets
import shutil
import socketserver
import subprocess
import sys
import threading
import time
import urllib.request
import webbrowser

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))  # the plugin root: this file is bin/huddle
HERE = os.path.join(ROOT, "skills", "huddle")
RUNTIME = os.path.join(HERE, "runtime")
TEMPLATES = os.path.join(HERE, "templates")
DEMOS = os.path.join(HERE, "demos")
CACHE = os.path.expanduser("~/.cache/huddle")
DEFAULTS = os.path.join(HERE, "defaults.json")
USER_DEFAULTS = os.path.expanduser(os.environ.get("HUDDLE_CONFIG", "~/.config/huddle/defaults.json"))
OUTDIR = os.path.join(os.environ.get("TMPDIR", "/tmp"), "huddle")
MERMAID_URL = "https://cdn.jsdelivr.net/npm/mermaid@11.12.0/dist/mermaid.min.js"
MERMAID_FILE = os.path.join(CACHE, "mermaid-11.12.0.min.js")
# jsDelivr's published sha256 for that file (data.jsdelivr.com/v1/package/npm/mermaid@11.12.0/flat).
# The page runs with agterm's bridge, which can type into terminals, so unverified code never goes in.
MERMAID_SHA256 = "07e37dfa97b337ccc85365d57eddf99b9706f09db3b59b260d0333b23b343c4b"
MAX_IMAGE = 8 * 1024 * 1024
# When the plugin's Stop hook finds a huddle page still open, it re-posts the asking status at these
# offsets (seconds): status hooks run in parallel with it, so a slower one may post after it does, and
# one slower than the last offset wins.
STOP_RECHECKS = (0.5, 1.5, 3, 6)
SOURCED = ("code", "diff", "md", "mermaid")  # blocks whose text may come from {"file": …}
CODE_MAX_LINES = 300  # a whole file past this needs `lines`: nobody reads 3,000 lines to find the 20 in question


def emit(obj, code):
    print(json.dumps(obj, ensure_ascii=False))
    sys.exit(code)


def die(msg, code=1):
    emit({"status": "error", "error": msg}, code)


# ---------- spec loading ----------

def load_spec(arg):
    if arg in (None, "-"):
        if sys.stdin.isatty():
            die("no spec: pass a JSON file or pipe one on stdin")
        raw = sys.stdin.read()
    else:
        try:
            with open(os.path.expanduser(arg), encoding="utf-8") as f:
                raw = f.read()
        except OSError as e:
            die(f"cannot read the spec: {e}")
    try:
        return json.loads(raw)
    except json.JSONDecodeError as e:
        die(f"spec is not valid JSON: {e}")


def check_spec(spec):
    if not isinstance(spec, dict):
        die("spec must be a JSON object")
    qs = spec.get("questions", [spec])
    if not isinstance(qs, list) or not qs:
        die("`questions` must be a non-empty list")
    ids = set()
    for i, q in enumerate(qs):
        if not isinstance(q, dict):
            die(f"question {i + 1} must be a JSON object, got {type(q).__name__}")
        qid = q.get("id") or (f"q{i + 1}" if spec.get("questions") else "answer")
        if qid in ids:
            die(f"duplicate question id {qid!r}")
        ids.add(qid)
        opts = q.get("options") or []
        if not isinstance(opts, list):
            die(f"question {qid!r}: `options` must be a list")
        if len(opts) > 9:
            die(f"question {qid!r} has {len(opts)} options; keys 1-9 cover at most 9 (aim for 6)")
        for j, o in enumerate(opts):
            if not isinstance(o, (str, dict)):
                die(f"question {qid!r}: option {j + 1} must be a string or an object")
        oids = [o if isinstance(o, str) else o.get("id") or f"o{j + 1}" for j, o in enumerate(opts)]  # as the runtime assigns them
        if len(oids) != len(set(oids)):
            die(f"question {qid!r} has duplicate option ids (an option without an id is o1, o2, … by position)")
        if not q.get("prompt") and not spec.get("title"):
            die(f"question {qid!r} has no prompt")


def line_range(spec, total, path):
    """`"40-60"`, `"40"` or `[40, 60]` → 1-based inclusive (first, last), checked against the file."""
    if isinstance(spec, list) and len(spec) == 2:
        first, last = spec
    else:
        a, _, b = str(spec).partition("-")
        first, last = a, b or a
    try:
        first, last = int(first), int(last)
    except (TypeError, ValueError):
        die(f"{path}: lines must look like \"40-60\", \"40\" or [40, 60], got {spec!r}")
    if not 1 <= first <= last <= total:
        die(f"{path}: lines {first}-{last} are outside the file's 1-{total}")
    return first, last


def load_files(node, base):
    """Replace `{"file": …}` in code, diff, md and mermaid blocks with the file's text.

    Source code pasted into JSON by hand is where a spec breaks or a snippet drifts from the
    real file; reading it here shows the user exactly what is on disk."""
    if isinstance(node, list):
        for v in node:
            load_files(v, base)
        return
    if not isinstance(node, dict):
        return
    for k in SOURCED:
        src = node.get(k)
        if not (isinstance(src, dict) and "file" in src):
            continue
        shown = src["file"]
        p = os.path.expanduser(shown)
        if not os.path.isabs(p):
            p = os.path.join(base, p)
        try:
            with open(p, encoding="utf-8") as f:
                text = f.read()
        except (OSError, UnicodeDecodeError) as e:
            die(f"{k} block: cannot read {shown}: {e}")
        lines = text.splitlines()
        if k == "code" and "lines" not in src and len(lines) > CODE_MAX_LINES:
            die(f"code block: {shown} has {len(lines)} lines; pass \"lines\" (\"40-62\") for the part the question is about")
        if k == "code" or "lines" in src:
            first, last = line_range(src["lines"], len(lines), shown) if "lines" in src else (1, len(lines))
            text = "\n".join(lines[first - 1:last])
            if k == "code":
                node.setdefault("start", first)
                node.setdefault("title", f"{shown}:{first}-{last}" if "lines" in src else shown)
                ext = os.path.splitext(p)[1].lstrip(".")
                if ext:
                    node.setdefault("lang", ext)
        node[k] = text
    for v in node.values():
        load_files(v, base)


def embed_images(node, base):
    """Replace local `image` paths with data URIs: a page without --cwd has no file access."""
    if isinstance(node, dict):
        for k, v in list(node.items()):
            if k == "image" and isinstance(v, str) and not v.startswith(("http://", "https://", "data:")):
                p = os.path.expanduser(v)
                if not os.path.isabs(p):
                    p = os.path.join(base, p)
                if not os.path.isfile(p):
                    node[k] = ""
                    node.setdefault("alt", f"missing image: {v}")
                    continue
                if os.path.getsize(p) > MAX_IMAGE:
                    die(f"image too large to embed (>8MB): {v}")
                mime = mimetypes.guess_type(p)[0] or "image/png"
                with open(p, "rb") as f:
                    node[k] = f"data:{mime};base64," + base64.b64encode(f.read()).decode()
            else:
                embed_images(v, base)
    elif isinstance(node, list):
        for v in node:
            embed_images(v, base)


def uses_mermaid(node):
    if isinstance(node, dict):
        return "mermaid" in node or any(uses_mermaid(v) for v in node.values())
    if isinstance(node, list):
        return any(uses_mermaid(v) for v in node)
    return False


def mermaid_js():
    """The pinned mermaid bundle, verified on every read; "" (diagrams show as source) when unavailable."""
    def verified(data):
        return hashlib.sha256(data).hexdigest() == MERMAID_SHA256
    try:
        with open(MERMAID_FILE, "rb") as f:
            data = f.read()
        if verified(data):
            return data.decode("utf-8")
        print(f"huddle: {MERMAID_FILE} fails its sha256 check; fetching it again", file=sys.stderr)
    except FileNotFoundError:
        pass
    except OSError as e:
        print(f"huddle: cannot read {MERMAID_FILE} ({e}); fetching it again", file=sys.stderr)
    try:
        with urllib.request.urlopen(MERMAID_URL, timeout=20) as r:
            data = r.read()
    except (OSError, http.client.HTTPException) as e:
        print(f"huddle: mermaid unavailable ({e}); diagrams show as source", file=sys.stderr)
        return ""
    if not verified(data):
        print(f"huddle: {MERMAID_URL} does not match its pinned sha256; not using it, diagrams show as source",
              file=sys.stderr)
        return ""
    try:
        os.makedirs(CACHE, exist_ok=True)
        tmp = MERMAID_FILE + f".{os.getpid()}.tmp"
        with open(tmp, "wb") as f:
            f.write(data)
        os.replace(tmp, MERMAID_FILE)
    except OSError as e:  # the page still gets the verified bundle; only the cache is lost
        print(f"huddle: cannot cache mermaid ({e})", file=sys.stderr)
    return data.decode("utf-8")


def build_html(spec, base):
    load_files(spec, base)
    embed_images(spec, base)
    def read(name):
        with open(os.path.join(RUNTIME, name), encoding="utf-8") as f:
            return f.read()
    css, js = read("huddle.css"), read("huddle.js")
    mm = mermaid_js() if uses_mermaid(spec) else ""
    data = json.dumps(spec, ensure_ascii=False).replace("</", "<\\/").replace("<!--", "<\\u0021--")
    title = spec.get("title") or (spec.get("questions") or [spec])[0].get("prompt") or "Question"
    esc = lambda s: str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    return (
        "<!doctype html><html><head><meta charset=\"utf-8\">"
        "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
        f"<title>{esc(title)[:120]}</title><style>{css}</style></head>"
        f"<body><div id=\"app\"></div><script type=\"application/json\" id=\"hd-spec\">{data}</script>"
        + (f"<script>{mm}</script>" if mm else "")
        + f"<script>{js}</script></body></html>"
    )


def write_page(html):
    os.makedirs(OUTDIR, exist_ok=True)
    now = time.time()
    for old in glob.glob(os.path.join(OUTDIR, "*.html")):  # keep a day for debugging
        try:
            if now - os.path.getmtime(old) > 86400:
                os.remove(old)
        except OSError:
            pass
    path = os.path.join(OUTDIR, time.strftime("%Y%m%d-%H%M%S-") + secrets.token_hex(3) + ".html")
    with open(path, "w", encoding="utf-8") as f:
        f.write(html)
    return path


def defaults():
    """The skill's neutral defaults.json, overlaid by the user's own file (HUDDLE_CONFIG)."""
    merged = {}
    for path in (DEFAULTS, USER_DEFAULTS):
        try:
            with open(path, encoding="utf-8") as f:
                merged.update(json.load(f))
        except FileNotFoundError:
            pass
        except (OSError, json.JSONDecodeError) as e:
            print(f"huddle: ignoring {path}: {e}", file=sys.stderr)
    return merged


def apply_defaults(spec):
    d = defaults()
    spec.setdefault("style", d.get("style", "refined"))
    spec.setdefault("review", d.get("review", "auto"))
    return spec


def auto_size(spec):
    """Pick the floating-panel percent from how much the page has to show."""
    qs = spec.get("questions") or [spec]
    blob = json.dumps(spec)
    visual = any(k in blob for k in ('"preview"', '"mermaid"', '"chart"', '"image"', '"stats"', '"table"'))
    compare = any(q.get("layout") == "compare" for q in qs)
    nopts = max((len(q.get("options") or []) for q in qs), default=0)
    if visual or compare or len(qs) > 2:
        return 90
    if spec.get("width") == "narrow" and nopts <= 4 and len(blob) < 1500:
        return 66
    return 78


# ---------- agterm ----------

def agtermctl():
    return (os.environ.get("AGTERMCTL") or shutil.which("agtermctl")
            or next((p for p in ("/opt/homebrew/bin/agtermctl", "/Applications/agterm.app/Contents/MacOS/agtermctl") if os.path.exists(p)), None))


def ctl(*args, check=True):
    exe = agtermctl()
    cmd = [exe, *args]
    if os.environ.get("AGTERM_SOCKET"):
        cmd += ["--socket", os.environ["AGTERM_SOCKET"]]
    r = subprocess.run(cmd, capture_output=True, text=True, check=False)
    if check and r.returncode not in (0, 2):
        raise RuntimeError((r.stderr or r.stdout).strip() or f"agtermctl exited {r.returncode}")
    return r


def in_agterm():
    return os.environ.get("AGTERM_ENABLED") == "1" and os.environ.get("AGTERM_SESSION_ID") and agtermctl()


def unattended():
    """Claude Code sets CLAUDE_CODE_SESSION_ATTENDED=0 in `claude -p` runs, which inherit
    AGTERM_ENABLED=1 when started from an agterm shell. A page there waits for nobody.

    The variable is undocumented (absent from the env-vars page as of Claude Code 2.1.296; read
    from that binary and measured), so only an explicit "0" refuses: if a later version drops it,
    the guard goes quiet rather than blocking attended sessions."""
    return os.environ.get("CLAUDE_CODE_SESSION_ATTENDED") == "0"


def set_status(args):
    sid, pid = os.environ.get("AGTERM_SESSION_ID"), os.environ.get("AGTERM_PANE_ID")
    extra = ["--pane-id", pid] if pid else []
    try:
        ctl("session", "status", *args, "--target", sid, *extra, check=False)
    except OSError as e:  # the glyph is a courtesy; never fail the question over it
        print(f"huddle: could not set the status glyph: {e}", file=sys.stderr)


def this_session():
    """This session's node from `agtermctl tree`, or None when agterm cannot say."""
    args = ["tree", "--json"] + (["--window", os.environ["AGTERM_WINDOW_ID"]] if os.environ.get("AGTERM_WINDOW_ID") else [])
    try:
        workspaces = json.loads(ctl(*args, check=False).stdout)["result"]["tree"]["workspaces"]
        return next((s for w in workspaces for s in w.get("sessions") or [] if s.get("id") == os.environ["AGTERM_SESSION_ID"]), None)
    except (OSError, json.JSONDecodeError, KeyError, TypeError, AttributeError):
        return None


def pending_huddle_page():
    """The id of a huddle page open on this session, or None.

    When the overlay slot is taken, the page in it is often this agent's own question, left
    pending by a timeout or a killed call whose output (and page id) is gone after compaction."""
    s = this_session() or {}
    ours = os.path.realpath(OUTDIR) + os.sep  # agterm reports /tmp/… where TMPDIR says /private/tmp/…
    for o in s.get("htmlOverlays") or []:
        if o.get("file") and os.path.realpath(o["file"]).startswith(ours):
            return o.get("id")
    return None


def hook_stop():
    """The plugin's Stop hook: when the turn ends with a huddle page still open, show the question.

    Status hooks (agterm's own, or the user's) post a "working" or "done" glyph at Stop, and a
    question waiting in the background, or one left pending by a timeout, would read as finished
    work. agterm already refuses a non-blocked status from the OTHER pane while this one is blocked,
    so only this session's own hooks can paint over it. Stop is the moment that is exact: the
    agent's turn is over and the page is still up. Claude Code runs matching hooks in parallel and
    in no fixed order, so this one cannot post last; it runs async (hooks.json) and re-posts the
    asking status at each STOP_RECHECKS offset whenever another hook has posted over it, then stops
    once the page is answered or closed. A Stop hook slower than the last offset still wins.
    It posts with --auto-reset: with no `huddle wait` left to reset it, the user's visit clears it.

    Not covered: Stop does not run when the user interrupts the turn (Escape), so then the glyph
    keeps whatever the last hook posted until the next turn ends; the user who pressed Escape is at
    that session, where the page is. And an async Stop hook outlives the next prompt (measured on
    Claude Code 2.1.296), so a turn that starts within the last offset may see asking re-posted over
    its own status until its next tool call; the question is still open then, so that is true.

    Never prints, never fails: a Stop hook's output or exit 2 could hold the session."""
    try:
        if not in_agterm() or unattended():
            return
        if not sys.stdin.isatty():
            sys.stdin.read()  # the hook's JSON input; nothing in it is needed
        page = pending_huddle_page()
        if not page:
            return
        asking = defaults().get("status", {}).get("asking", ["blocked"])
        ours = os.path.realpath(OUTDIR) + os.sep
        started = time.time()
        for at in STOP_RECHECKS:
            time.sleep(max(0, started + at - time.time()))
            s = this_session() or {}
            if not any(o.get("id") == page and o.get("file") and os.path.realpath(o["file"]).startswith(ours)
                       for o in s.get("htmlOverlays") or []):
                return  # answered or closed in the meantime
            if s.get("status") != asking[0]:
                set_status(asking + ["--auto-reset"])
    except Exception:  # noqa: BLE001 - a hook must never take the session down with it
        return

def open_overlay(path, a, spec):
    args = ["session", "overlay", "open", "--html", path, "--js", "--target", os.environ["AGTERM_SESSION_ID"], "--json"]
    if a.follow:
        args.append("--follow")
    size = a.size or spec.get("size") or defaults().get("size", "auto")
    if a.full or size == "full":
        size = None
    elif size == "auto":
        size = auto_size(spec)
    if size:
        args += ["--size-percent", str(int(size))]
    if a.chromeless:
        args.append("--chromeless")
    r = ctl(*args, check=False)
    try:
        reply = json.loads(r.stdout)
    except json.JSONDecodeError:
        die((r.stderr or r.stdout).strip() or "overlay open failed")
    if not reply.get("ok", True) or r.returncode != 0:
        err = reply.get("error") or (r.stderr or r.stdout).strip()
        if err == "overlay already open":
            page = pending_huddle_page()
            if page:
                emit({"status": "busy", "error": err, "pageID": page,
                      "hint": f"a huddle page is still open on this session, most likely your own unanswered "
                              f"question: run `huddle wait {page}` for its answer before asking anything new"}, 5)
            emit({"status": "busy", "error": err,
                  "hint": "another tool's overlay is open on this session (a diff review, a plan annotation); "
                          "ask in the terminal instead, and do not close an overlay you did not open"}, 5)
        die(err)
    res = reply.get("result", reply)
    return res.get("pageID") or res.get("id")


def wait_page(page_id, timeout, status=True):
    deadline = time.time() + timeout
    glyphs = defaults().get("status", {})
    asking = glyphs.get("asking", ["blocked"])
    if status:
        set_status(asking)
    still_open = False
    unreadable = 0
    try:
        while True:
            r = ctl("session", "overlay", "result", "--page", page_id, "--json", check=False)
            try:
                reply = json.loads(r.stdout)
            except json.JSONDecodeError:  # agterm did not answer at all: a stopped app, a missing socket
                unreadable += 1
                if unreadable >= 5:
                    die(f"agterm stopped answering about page {page_id}: {(r.stderr or r.stdout).strip()}")
                time.sleep(0.4)
                continue
            unreadable = 0
            if not reply.get("ok", True):  # `no such page`, `invalid page id`: waiting longer cannot help
                die(f"page {page_id}: {reply.get('error') or 'agterm refused the result request'}")
            o = reply.get("result", {}).get("pageOutcome", {})
            out = o.get("outcome")
            if out == "submitted":
                try:
                    ans = json.loads(o.get("value") or "{}")
                except json.JSONDecodeError:
                    ans = {"status": "answered", "answers": {"answer": {"selected": [], "labels": [], "text": o.get("value")}}}
                ans["pageID"] = page_id
                print(json.dumps(ans, ensure_ascii=False, indent=1))
                return 0
            if out == "dismissed":
                print(json.dumps({"status": "dismissed", "pageID": page_id}))
                return 2
            if time.time() > deadline:
                still_open = True  # the question is still up: keep the "asking" glyph
                if status:  # but let a visit clear it: with no waiter left, nothing else would after a ⌘W
                    set_status(asking + ["--auto-reset"])
                print(json.dumps({"status": "pending", "pageID": page_id,
                                  "hint": f"still open; run `huddle wait {page_id}` to keep waiting"}))
                return 4
            time.sleep(0.4)
    finally:
        if status and not still_open:
            set_status(glyphs.get("answered", ["active"]))


# ---------- browser fallback ----------

RELOAD_GRACE = 3  # seconds a dismissal waits for the page to come back (a reload also unloads it)


def ask_in_browser(html, timeout):
    state = {"answer": None, "dismissed_at": None}
    done = threading.Event()

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def do_GET(self):
            state["dismissed_at"] = None  # the page is back: that unload was a reload
            body = html.encode()
            self.send_response(200)
            self.send_header("content-type", "text/html; charset=utf-8")
            self.send_header("content-length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_POST(self):
            n = int(self.headers.get("content-length", 0))
            try:
                body = json.loads(self.rfile.read(n))
            except json.JSONDecodeError:
                body = {}
            self.send_response(204)
            self.end_headers()
            if body.get("status") == "dismissed":
                state["dismissed_at"] = time.time()
            else:
                state["answer"] = body
                done.set()

    srv = socketserver.TCPServer(("127.0.0.1", 0), H)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    url = f"http://127.0.0.1:{srv.server_address[1]}/"
    if not webbrowser.open(url):
        srv.shutdown()
        die("not inside agterm and no browser could be opened", 3)
    print(f"huddle: opened {url}", file=sys.stderr)
    deadline = time.time() + timeout
    while not done.wait(0.25):
        gone = state["dismissed_at"]
        if gone and time.time() - gone > RELOAD_GRACE:
            srv.shutdown()
            print(json.dumps({"status": "dismissed"}))
            return 2
        if time.time() > deadline:  # the server is gone with this process, so it cannot be resumed
            srv.shutdown()
            print(json.dumps({"status": "timeout", "hint": "browser questions cannot be resumed; ask again with a longer --timeout"}))
            return 4
    srv.shutdown()
    print(json.dumps(state["answer"], ensure_ascii=False, indent=1))
    return 0


# ---------- commands ----------

def ask(spec, a, base):
    check_spec(spec)
    if unattended():
        emit({"status": "unattended",
              "error": "this is an unattended run (CLAUDE_CODE_SESSION_ATTENDED=0); nobody is there to answer",
              "hint": "do not ask: proceed on the documented default, or stop and report what you need decided"}, 3)
    # Outside agterm the browser is opt-in: the skill tells the agent to just run huddle rather than check
    # for agterm first, so an unasked-for browser tab must not be what happens in a plain terminal.
    browser = a.browser or (not in_agterm() and defaults().get("browser") is True)
    if not in_agterm() and not browser:
        emit({"status": "no-agterm", "error": "not inside agterm, so there is no overlay to show the page in",
              "hint": "ask in the terminal; --browser, or \"browser\": true in ~/.config/huddle/defaults.json, "
                      "opens the page in the browser instead"}, 3)
    apply_defaults(spec)
    if a.style:
        spec["style"] = a.style
    if a.review:
        spec["review"] = a.review
    html = build_html(spec, base)
    if browser:
        if a.no_wait:
            die("--no-wait needs agterm: the browser fallback answers only while this process runs")
        return ask_in_browser(html, a.timeout)
    path = write_page(html)
    page = open_overlay(path, a, spec)
    if a.no_wait:
        print(json.dumps({"status": "open", "pageID": page, "file": path}))
        return 0
    return wait_page(page, a.timeout, status=not a.no_status)


def quick_spec(a):
    opts = []
    for i, raw in enumerate(a.options):
        rec = raw.startswith("*")
        label, _, rest = raw.lstrip("*").partition("|")
        sub, _, why = rest.partition("|")
        o = {"id": f"o{i + 1}", "label": label.strip()}
        if sub.strip():
            o["subtitle"] = sub.strip()
        if rec:
            o["recommended"] = why.strip() or True
        opts.append(o)
    spec = {"prompt": a.prompt, "options": opts}
    if a.multi:
        spec["mode"] = "multi"
    if a.context:
        spec["context"] = a.context
    if a.title:
        spec["title"] = a.title
    if opts:
        spec["width"] = "narrow"
    return spec


def list_dir(d):
    rows = []
    for p in sorted(glob.glob(os.path.join(d, "*.json"))):
        try:
            with open(p, encoding="utf-8") as f:
                s = json.load(f)
            rows.append((os.path.basename(p)[:-5], s.get("_about", "")))
        except (OSError, json.JSONDecodeError) as e:
            rows.append((os.path.basename(p)[:-5], f"(unreadable: {e})"))
    return rows


def main():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--follow", action="store_true", help="select this session so the user sees it now")
    common.add_argument("--size", type=int, help="floating panel, percent of the session (1-100); default auto")
    common.add_argument("--full", action="store_true", help="cover the whole session instead of a floating panel")
    common.add_argument("--style", choices=["refined", "minimal", "bold", "terminal"], help="visual style (default from defaults.json)")
    common.add_argument("--review", choices=["auto", "always", "never"], help="show the answer review before sending")
    common.add_argument("--chromeless", action="store_true", help="hide the overlay's title strip")
    common.add_argument("--timeout", type=float, default=570, help="seconds to wait (default 570)")
    common.add_argument("--no-wait", action="store_true", help="open and print the page id; read it later with `huddle wait`")
    common.add_argument("--no-status", action="store_true", help="leave the sidebar status glyph alone")
    common.add_argument("--browser", action="store_true", help="open the page in the local browser: outside agterm, or instead of the overlay")

    argv = sys.argv[1:]
    sub = argv[0] if argv and argv[0] in ("q", "wait", "demo", "templates", "render", "ask", "hook-stop") else None
    if sub is None:
        argv = ["ask", *argv]
        sub = "ask"

    p = argparse.ArgumentParser(prog="huddle", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = p.add_subparsers(dest="cmd")
    s_ask = sp.add_parser("ask", parents=[common]); s_ask.add_argument("spec", nargs="?")
    s_q = sp.add_parser("q", parents=[common]); s_q.add_argument("prompt"); s_q.add_argument("options", nargs="*")
    s_q.add_argument("--multi", action="store_true"); s_q.add_argument("--context"); s_q.add_argument("--title")
    s_w = sp.add_parser("wait", parents=[common]); s_w.add_argument("page_id")
    s_d = sp.add_parser("demo", parents=[common]); s_d.add_argument("names", nargs="*")
    sp.add_parser("templates")
    s_r = sp.add_parser("render"); s_r.add_argument("spec"); s_r.add_argument("-o", "--out", required=True)
    sp.add_parser("hook-stop")
    a = p.parse_args(argv)

    if a.cmd == "hook-stop":
        hook_stop()
        sys.exit(0)

    if a.cmd == "ask":
        base = os.path.dirname(os.path.abspath(a.spec)) if a.spec not in (None, "-") else os.getcwd()
        sys.exit(ask(load_spec(a.spec), a, base))
    if a.cmd == "q":
        sys.exit(ask(quick_spec(a), a, os.getcwd()))
    if a.cmd == "wait":
        if not in_agterm():
            die("not inside agterm", 3)
        sys.exit(wait_page(a.page_id, a.timeout, status=not a.no_status))
    if a.cmd == "templates":
        for name, about in list_dir(TEMPLATES):
            print(f"{name:18} {about}")
        print(f"\n{TEMPLATES}")
        return
    if a.cmd == "demo":
        if not a.names:
            for name, about in list_dir(DEMOS) + list_dir(TEMPLATES):
                print(f"{name:18} {about}")
            return
        code = 0
        for name in a.names:
            path = next((os.path.join(d, name + ".json") for d in (DEMOS, TEMPLATES) if os.path.isfile(os.path.join(d, name + ".json"))), None)
            if not path:
                die(f"no demo or template named {name!r}")
            code = ask(load_spec(path), a, os.path.dirname(path))
            if code not in (0, 2):
                break
        sys.exit(code)
    if a.cmd == "render":
        spec = load_spec(a.spec)
        check_spec(spec)
        apply_defaults(spec)
        base = os.path.dirname(os.path.abspath(a.spec)) if a.spec != "-" else os.getcwd()
        with open(a.out, "w", encoding="utf-8") as f:
            f.write(build_html(spec, base))
        print(a.out)


if __name__ == "__main__":
    main()
